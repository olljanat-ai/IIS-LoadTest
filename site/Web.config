<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Safety limits. Any URL parameter above its limit is capped and the cap is
    reported in the response under "warnings", so a mistyped URL cannot take the
    server down. Tune these for the box you are testing.
  -->
  <appSettings>
    <add key="LoadTest.Enabled" value="true" />
    <add key="LoadTest.MaxCpuMs" value="60000" />
    <add key="LoadTest.MaxCpuThreads" value="64" />
    <add key="LoadTest.MaxMemoryMB" value="1024" />
    <add key="LoadTest.MaxRetainedMB" value="2048" />
    <add key="LoadTest.MaxFileTotalMB" value="1024" />
    <add key="LoadTest.MaxDelayMs" value="60000" />
    <!-- Empty means the process temp directory. Set it to the volume or UNC
         share you want to measure, and grant the application pool identity
         write access there. Not settable through the URL. -->
    <add key="LoadTest.TempPath" value="" />
  </appSettings>

  <system.web>
    <!-- Change targetFramework if the server has an older 4.x runtime. -->
    <compilation debug="false" targetFramework="4.8" />
    <!-- executionTimeout has to outlast the largest load a URL can ask for. -->
    <httpRuntime targetFramework="4.8"
                 executionTimeout="900"
                 enableVersionHeader="false"
                 maxRequestLength="4096" />
    <customErrors mode="RemoteOnly" />
    <pages enableViewState="false" enableSessionState="false" />
    <sessionState mode="Off" />
  </system.web>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <!--
      A load generator should not be reachable by just anyone. Restrict it to
      the hosts that run your tests, either here or in the IIS site bindings.
      Requires the IP and Domain Restrictions feature (Web-IP-Security).

    <security>
      <ipSecurity allowUnlisted="false">
        <add ipAddress="127.0.0.1" allowed="true" />
        <add ipAddress="10.0.0.0" subnetMask="255.0.0.0" allowed="true" />
      </ipSecurity>
    </security>
    -->
  </system.webServer>

</configuration>
